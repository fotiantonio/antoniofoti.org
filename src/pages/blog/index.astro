---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import { posts } from '../../data/posts';
---

<Base title="Blog — Antonio Foti" description="Notes on shipping, code, and the indie path." path="/blog/">
  <TopBar />

  <main class="mx-auto max-w-3xl px-6 pt-12 pb-6">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight">
        <span class="text-[var(--color-accent)]">#</span> blog
      </h1>
      <p class="mt-1 text-sm text-[var(--color-muted)]">Notes on shipping, code, and the indie path.</p>
    </header>

    {posts.length === 0 ? (
      <p class="text-[var(--color-muted)] text-sm">No posts yet.</p>
    ) : (
      <ul class="divide-y divide-[var(--color-line)]">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="block py-5 group">
              <div class="flex justify-between gap-4 items-baseline">
                <code class="text-sm text-[var(--color-muted)] group-hover:text-[var(--color-accent)] transition-colors">
                  ~/{post.id}.mdx
                </code>
                <time class="text-xs text-[var(--color-muted)] tabular-nums shrink-0" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h2 class="mt-1.5 text-base font-medium group-hover:text-[var(--color-accent)] transition-colors">{post.data.title}</h2>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{post.data.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>

  <Footer />
</Base>

---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, excerpt, tags } = post.data;
const siteUrl = Astro.site;
if (!siteUrl) throw new Error('Astro site URL not set');
const postUrl = new URL(`/blog/${post.id}/`, siteUrl).toString();
const ogImage = new URL('/og-default.png', siteUrl).toString();
const publishedISO = date.toISOString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  datePublished: publishedISO,
  dateModified: publishedISO,
  author: { '@type': 'Person', name: 'Antonio Foti', url: siteUrl.toString() },
  publisher: { '@type': 'Person', name: 'Antonio Foti', url: siteUrl.toString() },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  image: ogImage,
  keywords: tags.join(', '),
};
---

<Base
  title={`${title} — Antonio Foti`}
  description={excerpt}
  path={`/blog/${post.id}/`}
  type="article"
  publishedTime={publishedISO}
  modifiedTime={publishedISO}
  author="Antonio Foti"
  tags={tags}
  schema={schema}
>
  <TopBar />

  <article>
    <main class="mx-auto max-w-3xl px-6 pt-12 pb-6">
      <code class="text-xs text-[var(--color-muted)]">~/{post.id}.mdx</code>

      <header class="mt-3 mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
        <div class="mt-3 text-xs text-[var(--color-muted)]">
          <span class="text-[var(--color-accent)]">//</span>{' '}
          published {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {tags.length > 0 && (
            <>
              {' '}·{' '}
              {tags.map((t, i) => (
                <>{i > 0 && ' '}<span class="text-[var(--color-accent)]">#{t}</span></>
              ))}
            </>
          )}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <hr class="border-[var(--color-line)] my-10" />
      <a href="/blog" class="text-sm text-[var(--color-accent)] hover:opacity-80">← cd ~/blog</a>
    </main>

    <Footer />
  </article>
</Base>

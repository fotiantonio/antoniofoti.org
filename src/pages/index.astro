---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import NowRow from '../components/NowRow.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const siteUrl = Astro.site;
if (!siteUrl) throw new Error('Astro site URL not set');
const homeUrl = siteUrl.toString();
const ogImage = new URL('/og-default.png', siteUrl).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: homeUrl,
  image: ogImage,
  jobTitle: 'Indie Maker',
  description: site.bio,
  address: { '@type': 'PostalAddress', addressLocality: site.now.location },
  knowsAbout: site.now.stack,
  sameAs: site.socials.map((s) => s.href),
};
---

<Base schema={personSchema}>
  <TopBar />

  <main class="mx-auto max-w-3xl px-6 pt-12 pb-6">
    <Hero />

    <section class="mt-10">
      <NowRow />
    </section>

    <section id="projects" class="mt-14">
      <h2 class="text-[0.65rem] uppercase tracking-widest text-[var(--color-muted)] mb-4">
        <span class="text-[var(--color-accent)]">//</span> projects
      </h2>
      <ProjectGrid />
    </section>

    {posts.length > 0 && (
      <section id="writing" class="mt-14">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="text-[0.65rem] uppercase tracking-widest text-[var(--color-muted)]">
            <span class="text-[var(--color-accent)]">//</span> writing
          </h2>
          <a href="/blog" class="text-xs text-[var(--color-muted)] hover:text-[var(--color-accent)]">~/blog →</a>
        </div>
        <ul class="divide-y divide-[var(--color-line)]">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="flex justify-between gap-4 py-3 group">
                <span class="group-hover:text-[var(--color-accent)] transition-colors truncate">
                  {post.data.title}
                </span>
                <time class="text-xs text-[var(--color-muted)] shrink-0 tabular-nums" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <Footer />
</Base>

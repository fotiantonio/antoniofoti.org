---
import { site } from '../data/site';
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-[rgba(10,10,10,0.85)] backdrop-blur"
>
  <div class="mx-auto max-w-3xl px-6 h-12 flex items-center justify-between">
    <nav class="flex items-center gap-1 text-sm text-[var(--color-muted)] overflow-hidden">
      <a href="/" class="inline-flex items-center hover:text-[var(--color-accent)] transition-colors">
        <img src="/logo.svg" alt="" width="16" height="16" class="size-4 rounded-sm shrink-0" />
      </a>
      <span class="text-[var(--color-line)]">/</span>
      <a href="/" class="inline-flex items-center text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors">
        {site.domain}
      </a>
    </nav>
  </div>
</header>

---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] mt-24">
  <div class="mx-auto max-w-3xl px-6 py-8 flex flex-col sm:flex-row gap-3 items-center justify-between text-xs">
    <p class="text-[var(--color-muted)]">
      <span class="text-[var(--color-accent)]">$</span> exit 0 — © {year} {site.name}
    </p>
    <nav class="flex flex-wrap gap-2">
      {site.socials.map((s) => (
        <a href={s.href} target="_blank" rel="me noopener" class="sochip">
          {s.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

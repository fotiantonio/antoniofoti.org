---
const socials = [
  { label: 'x', href: 'https://x.com/antoniofoti' },
  { label: 'github', href: 'https://github.com/antoniofoti' },
];
const { compact = false } = Astro.props;
---

<nav class={`flex gap-4 text-sm ${compact ? '' : 'text-[var(--color-muted)]'}`}>
  {socials.map((s) => (
    <a
      href={s.href}
      target="_blank"
      rel="me noopener"
      class="uppercase tracking-wide hover:text-[var(--color-accent)] transition-colors"
    >
      {s.label}
    </a>
  ))}
</nav>

---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<section class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
  <div>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{site.name}</h1>
    <p class="mt-2 text-[var(--color-muted)] text-sm">
      <span class="text-[var(--color-accent)]">#</span> {site.bio}
    </p>
    <div class="mt-4">
      <SocialLinks />
    </div>
  </div>
</section>

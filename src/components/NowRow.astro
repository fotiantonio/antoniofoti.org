---
import { site } from '../data/site';
const { location, stack, focus } = site.now;
const cells = [
  { label: 'location', value: location },
  { label: 'stack', value: stack.join(' · ') },
  { label: 'focus', value: focus },
];
---

<section class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-[var(--color-line)] border border-[var(--color-line)] rounded-lg overflow-hidden">
  {cells.map((c) => (
    <div class="bg-[var(--color-bg)] p-4">
      <div class="text-[0.65rem] uppercase tracking-widest text-[var(--color-muted)]">{c.label}</div>
      <div class="mt-1 text-sm text-[var(--color-accent)]">{c.value}</div>
    </div>
  ))}
</section>

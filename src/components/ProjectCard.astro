---
import { site } from '../data/site';
import { statusMeta } from '../data/site';
import type { CollectionEntry } from 'astro:content';

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { name, tagline, url, revenue, acquired, founded, users, subs, status, tech, logo } = project.data;
const meta = statusMeta[status] ?? statusMeta.active;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="card group block p-4 rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)]"
  style={`--dot: ${meta.dot};`}
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3 min-w-0">
      {logo && (
        <img src={logo} alt={`${name} icon`} width="24" height="24" class="size-6 rounded object-cover border border-[var(--color-line)] shrink-0" />
      )}
      <span class="font-semibold truncate">{name}</span>
      <span class="pill">{meta.label}</span>
    </div>
    {(revenue || acquired) && (
      <div class="text-right shrink-0 flex flex-col gap-0.5 text-xs">
        {revenue && (
          <span class="tabular-nums">
            <span class="text-[var(--color-muted)]">revenue · </span>
            <span class="text-[var(--color-accent)]">{revenue}</span>
          </span>
        )}
        {acquired && (
          <span class="tabular-nums">
            <span class="text-[var(--color-muted)]">sold for · </span>
            <span class="text-[var(--color-accent)]">{acquired}</span>
          </span>
        )}
      </div>
    )}
  </div>

  <p class="mt-2 text-sm text-[var(--color-muted)] truncate">{tagline}</p>

  {founded && (
    <p class="mt-1 text-xs text-[var(--color-muted)]">
      founded · <time datetime={founded.toISOString()}>
        {founded.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
      </time>
    </p>
  )}

  {(users || subs) && (
    <p class="mt-1 text-xs text-[var(--color-muted)] tabular-nums">
      {users && <>free users · {users}</>}
      {users && subs && <> · </>}
      {subs && <>paid subs · {subs}</>}
    </p>
  )}

  <div class="mt-3 flex flex-wrap gap-1.5 opacity-0 max-h-0 group-hover:opacity-100 group-hover:max-h-20 transition-all duration-200 overflow-hidden">
    {tech.map((t) => <span class="chip">{t}</span>)}
  </div>
</a>
